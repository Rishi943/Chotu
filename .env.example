# Copy to .env and fill in your values
PI_HOST=http://chotu.local:7000
PALIV_BRAIN_URL=http://localhost:8080/v1
PALIV_BRAIN_KEY=not-needed
PALIV_BRAIN_MODEL=Qwen3.5-4B-Q4_K_M.gguf

# Voice input (set to 1 to enable wake word + STT instead of terminal)
PALIV_VOICE=0
PALIV_WAKE_WORD_MODEL=
PALIV_WHISPER_MODEL=small
PALIV_WAKE_THRESHOLD=0.5
# PALIV_MIC_DEVICE=  # leave blank for default mic; set to device index or name for ReSpeaker

# Tuya local light control
TUYA_DEVICE_ID=your-device-id
TUYA_LOCAL_KEY=your-local-key
TUYA_LIGHT_IP=192.168.x.x
TUYA_VERSION=3.3
